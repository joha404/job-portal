// middleware/verifyToken.js

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  role       Role     @default(User)
  created_at DateTime @default(now())
}

model Job {
  id         Int      @id @default(autoincrement())
  name       String
  vacency    String
  position   String
  experience String
  sellery    String
  education  String
  location   String
  created_at DateTime @default(now())
}

enum Role {
  Admin
  User
}
